# HTTP RPC (Helius / другой провайдер; PublicNode как запасной)
RPC_URL=https://solana-rpc.publicnode.com
# WebSocket-источники для обнаружения новых пулов (logsSubscribe), через запятую.
# Работают параллельно, дубликаты отсекаются. Пример с Helius + PublicNode:
# WS_URLS=wss://mainnet.helius-rpc.com/?api-key=ВАШ_КЛЮЧ,wss://solana-rpc.publicnode.com
WS_URLS=wss://solana-rpc.publicnode.com
# Переподключение, если источник молчит столько секунд
WS_STALL_SECS=20
# Адреса операторов (создатели и т.п.), чьи транзакции опрашиваются напрямую по HTTP:
# все их запуски находятся независимо от websocket и всегда отслеживаются. Через запятую.
WATCH_ADDRESSES=
# Ограничение запросов к HTTP RPC в секунду
RPC_RPS=5
# Путь к базе
DB_PATH=dbc.sqlite
# Отслеживать каждый N-й пул (1 = все)
SAMPLE_EVERY=4
# Конфиги, пулы которых отслеживать всегда (через запятую, можно пусто)
CONFIG_ALLOWLIST=
# Сколько часов после создания собирать свопы пула
TRACK_HOURS=24
# Пауза между проходами опроса пулов, секунды
POLL_INTERVAL_SECS=20
# Уровень логов
RUST_LOG=info

# ---- Telegram-бот (dbc-radar-bot), читает тот же .env ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=DBC_Radar_bot
# путь к dbc-replay относительно папки запуска
REPLAY_BIN=replay/target/release/dbc-replay
# пересчёт оценок, секунды
REFRESH_SECS=300
# канал оповещений: @username канала или числовой id; бот должен быть администратором канала
ALERT_CHAT=
# сводка в канал, секунды (21600 = 6 часов)
DIGEST_SECS=21600
# узел с полной историей (например, Helius HTTP) — только для поиска пула по адресу токена в боте
HISTORY_RPC_URL=
