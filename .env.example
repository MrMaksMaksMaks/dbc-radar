# ---- Collector ----
# HTTP RPC endpoint
RPC_URL=https://solana-rpc.publicnode.com
# Websocket sources for pool discovery (logsSubscribe), comma-separated.
# They run in parallel and duplicates are dropped. Example:
# WS_URLS=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY,wss://solana-rpc.publicnode.com
WS_URLS=wss://solana-rpc.publicnode.com
# Reconnect a source that has been silent for this many seconds
WS_STALL_SECS=20
# Operator addresses polled directly over HTTP: all their launches are found and tracked. Comma-separated.
WATCH_ADDRESSES=
# Configs whose pools are always tracked. Comma-separated.
CONFIG_ALLOWLIST=
# Track every N-th new pool (1 = all)
SAMPLE_EVERY=2
# How many hours to collect swaps for each pool
TRACK_HOURS=3
# Graduation check from pool accounts (all pools, one getMultipleAccounts per 100 pools):
# how often, seconds, and how far back, hours
GRAD_CHECK_SECS=120
GRAD_CHECK_HOURS=24
# Separate RPC for this check (PublicNode accepts only ~6 accounts per getMultipleAccounts);
# empty = RPC_URL. Requests per second for it:
STATUS_RPC_URL=https://api.mainnet-beta.solana.com
STATUS_RPC_RPS=2
# Backup RPC for transactions the main RPC no longer serves (empty = HISTORY_RPC_URL); its rate limit
# and an hourly cap on backup requests. Without a backup such a transaction is skipped with a warning.
BACKUP_RPC_URL=
BACKUP_RPC_RPS=2
BACKUP_MAX_PER_HOUR=1000
# Pause between polling rounds, seconds
POLL_INTERVAL_SECS=20
# HTTP requests per second
RPC_RPS=5
# SQLite database
DB_PATH=dbc.sqlite
RUST_LOG=info

# ---- Telegram bot (reads the same .env) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=DBC_Radar_bot
# Path to dbc-replay relative to the working directory
REPLAY_BIN=replay/target/release/dbc-replay
# How often verdicts are recomputed, seconds
REFRESH_SECS=300
# RPC with full transaction history (e.g. Helius HTTP), only for finding the pool of an older token
HISTORY_RPC_URL=
# Alert channel: @channel_name or numeric id (the bot must be an admin); empty = no alerts
ALERT_CHAT=
# Digest period for the alert channel, seconds (21600 = 6 hours)
DIGEST_SECS=21600

# ---- Public HTTP API (served by the bot process) ----
# Listen address; keep it on localhost and publish through Cloudflare Tunnel. Empty = API off.
API_BIND=127.0.0.1:8080
# Comma-separated keys: with a key, unknown addresses are looked up on-chain and the rate limit is higher
API_KEYS=
# Requests per minute per IP without / with a key
API_RATE_PUBLIC=30
API_RATE_KEY=300

# ---- Verdict thresholds (dbc-replay risk; the bot passes its environment to dbc-replay) ----
# Empty = built-in default. `replay/target/release/dbc-replay thresholds` prints the values in effect.
# Restart the bot after changing them: it loads .env once at start.
# Evidence points for RED (a strong trading signal is also required) and capability points for AMBER
RISK_RED_MIN_EVIDENCE=
RISK_AMBER_MIN_CAPABILITY=
# Strong trading signal: share of volume from creator-linked wallets (0.8) or median fan-out wallets per pool (10)
RISK_STRONG_LINKED_SHARE=
RISK_STRONG_FANOUT_WALLETS=
# Curve filled faster than this median, seconds (300), is flagged
RISK_FAST_MIGRATION_SECS=
# Sniper fee: starting fee % (70), decay duration s (90), share of the fee taken by one address % (80), points (50)
RISK_FEE_TRAP_MIN_START_PCT=
RISK_FEE_TRAP_MIN_SECS=
RISK_FEE_TRAP_MIN_SHARE_PCT=
RISK_FEE_TRAP_POINTS=
# Evidence points for sharing a parameter template with RED configs (0 = shown as a note only)
RISK_TEMPLATE_POINTS=
# Platform guard: a launchpad with this many configs (5), under half of them RED; its config with this many
# creators (10) gets RED only on direct evidence (mass fan-out or proxy trading), otherwise AMBER
RISK_PLATFORM_GUARD_MIN_CONFIGS=
RISK_PLATFORM_GUARD_MIN_CREATORS=
